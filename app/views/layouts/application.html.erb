<!DOCTYPE html>
<html lang="en" class="motion-safe:scroll-smooth">
  <head>
    <title><%= content_for(:title) || "Kaleigh Unger - Resume, on Rails" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Resume on Rails">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <% page_title = content_for(:title) || "#{Profile.current.name} - Resume, on Rails" %>
    <% page_description = content_for(:description) ||
         "#{Profile.current.name} - #{Profile.current.headline}. A resume built as a working Rails app." %>
    <meta name="description" content="<%= page_description %>">
    <meta property="og:title" content="<%= page_title %>">
    <meta property="og:description" content="<%= page_description %>">
    <meta property="og:type" content="website">
    <meta property="og:url" content="<%= request.original_url %>">
    <meta property="og:image" content="<%= request.base_url %>/icon.png">
    <meta name="twitter:card" content="summary">

    <%= yield :head %>

    <%# ?v= busts the one-year cache on public/ assets. Anyone who loaded the
        site before the SVG was fixed is holding a broken icon otherwise. %>
    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="icon" href="/icon.svg?v=2" type="image/svg+xml">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="apple-touch-icon" href="/icon.png">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@500;600&display=swap" rel="stylesheet">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-slate-50 text-slate-800 antialiased">
    <header class="sticky top-0 z-20 border-b border-slate-200 bg-white">
      <div class="max-w-4xl mx-auto px-6 h-14 flex items-center justify-between">
        <%= link_to root_path, class: "font-semibold tracking-tight text-slate-900" do %>
          Kaleigh Unger
        <% end %>
        <nav class="flex items-center gap-4 sm:gap-6 text-sm font-medium text-slate-600">
          <%= link_to "Headline", root_path, class: nav_class(root_path) %>
          <%= link_to "Timeline", timeline_path, class: nav_class(timeline_path) %>
          <%= link_to "Carline", carline_path, class: nav_class(carline_path) %>
          <%= link_to print_path, title: "Printable resume", "aria-label": "Printable resume",
                class: "text-slate-500 hover:text-indigo-600" do %>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"
                 stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5" aria-hidden="true">
              <path d="M7 3h10v4H7z"/>
              <rect x="3" y="7" width="18" height="8" rx="2"/>
              <path d="M7 15h10v6H7z"/>
              <circle cx="17.5" cy="10.5" r=".9" fill="currentColor" stroke="none"/>
            </svg>
          <% end %>
        </nav>
      </div>
    </header>

    <main class="max-w-4xl mx-auto px-6 py-12">
      <%= yield %>
    </main>

    <footer class="max-w-4xl mx-auto px-6 py-10 mt-12 border-t border-slate-200 text-sm text-slate-500">
      Built with Ruby on Rails, as a follow-up to an unexpectedly fun convo at CCC with some cool people.
      <% if Profile.current&.github_url.present? %>
        · <%= link_to "source on GitHub", Profile.current.github_url, target: "_blank", rel: "noopener", class: "underline hover:text-indigo-600" %>
      <% end %>
    </footer>
  </body>
</html>
