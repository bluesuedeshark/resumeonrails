<% content_for :title, "By the numbers — #{Profile.current.name}" %>

<h1 class="text-2xl font-bold text-slate-900 mb-2">By the numbers</h1>
<p class="text-slate-600 mb-10">The same career data, aggregated instead of narrated.</p>

<div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-16">
  <div class="bg-white border border-slate-200 rounded-lg p-5">
    <p class="text-3xl font-bold text-indigo-600"><%= @total_years %></p>
    <p class="text-sm text-slate-500 mt-1">years across roles</p>
  </div>
  <div class="bg-white border border-slate-200 rounded-lg p-5">
    <p class="text-3xl font-bold text-indigo-600"><%= @accomplishment_count %></p>
    <p class="text-sm text-slate-500 mt-1">logged accomplishments</p>
  </div>
  <div class="bg-white border border-slate-200 rounded-lg p-5">
    <p class="text-3xl font-bold text-indigo-600"><%= @skill_count %></p>
    <p class="text-sm text-slate-500 mt-1">distinct skills</p>
  </div>
  <div class="bg-white border border-slate-200 rounded-lg p-5">
    <p class="text-3xl font-bold text-indigo-600"><%= Role.count %></p>
    <p class="text-sm text-slate-500 mt-1">roles held</p>
  </div>
</div>

<%
  snowflake_note = "Next: a live panel here querying a real Snowflake table directly — placeholder until the account exists."
%>
<div class="mb-16 border border-dashed border-slate-300 rounded-lg p-5 text-sm text-slate-500">
  <span class="font-semibold text-slate-600">Coming next:</span> <%= snowflake_note %>
</div>

<h2 class="text-lg font-semibold text-slate-900 mb-4">Wins with a hard number attached</h2>
<ul class="space-y-3">
  <% @featured.each do |a| %>
    <li class="bg-white border border-slate-200 rounded-lg p-4">
      <p class="text-sm text-slate-700"><%= a.description %></p>
      <p class="text-indigo-600 font-semibold mt-1"><%= a.metric %></p>
      <p class="text-xs text-slate-400 mt-1"><%= a.role.title %> · <%= a.role.organization %></p>
    </li>
  <% end %>
</ul>
