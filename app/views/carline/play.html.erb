<% content_for :title, "Stuck in Carline? - #{Profile.current.name}" %>

<p class="text-sm mb-4"><%= link_to "← Back to the analysis", carline_path, class: "text-indigo-600 hover:text-indigo-800" %></p>

<h1 class="text-2xl font-bold text-slate-900 mb-1">Stuck in carline right now?</h1>
<p class="text-slate-600 mb-1">Pretend your car is actually moving.</p>
<p class="text-sm text-slate-500 mb-6">
  <span class="font-medium text-slate-700">Goal:</span> jump your car 🚗 over stuff in the road, make it to your kid 🧒.
  <span class="font-medium text-slate-700">Controls:</span> tap the road (or the button, or spacebar) to jump.
  Each level starts with a couple of safe seconds to try a practice jump.
</p>

<div class="max-w-sm mx-auto" data-controller="carline-game">
  <div class="flex items-center justify-between mb-2 text-sm font-medium text-slate-600">
    <span data-carline-game-target="level">Level 1</span>
    <button data-action="carline-game#start" class="text-indigo-600 hover:text-indigo-800 font-semibold">
      Start
    </button>
  </div>

  <div class="relative">
    <canvas data-carline-game-target="canvas" width="320" height="220" class="w-full rounded-lg border border-slate-300 touch-none select-none"></canvas>

    <div data-carline-game-target="overlay" class="hidden absolute inset-0 flex flex-col items-center justify-center gap-4 bg-slate-900/90 backdrop-blur-sm rounded-lg p-5 text-center">
      <div data-carline-game-target="status" class="text-sm font-medium text-white leading-relaxed"></div>
      <div data-carline-game-target="actions" class="flex gap-3 w-full max-w-56"></div>
    </div>
  </div>

  <button data-action="carline-game#jump" class="w-full bg-slate-100 hover:bg-slate-200 active:bg-slate-300 rounded-lg py-5 text-lg font-bold text-slate-700 select-none mt-2">
    JUMP
  </button>

  <p class="text-xs text-slate-400 mt-4 text-center">Spacebar works too, if you're on a real keyboard.</p>
</div>
