<% content_for :title, "Carline, Data-Driven — #{Profile.current.name}" %>

<p class="text-sm font-semibold text-indigo-600 tracking-wide uppercase mb-2">If the carline were a data problem</p>
<h1 class="text-3xl font-bold text-slate-900 mb-3">Carline: The Problem of Pain <span class="text-slate-400 font-normal text-xl">(not the C.S. Lewis one :-)</span></h1>
<p class="text-xs text-slate-400 max-w-2xl mb-8">
  Not pulled from real data, but imagined from real carline woes :-) What's real is how I'd actually
  work it: not just the surface numbers, but digging, combining datasets, looking for patterns that
  weren't obvious on the first pass — data science rigor, outside-of-the-box thinking.
</p>

<div class="sticky top-0 z-30 -mx-6 px-6 py-3 mb-12 bg-indigo-50/95 backdrop-blur border-b border-indigo-200 shadow-sm flex flex-col sm:flex-row sm:items-center justify-between gap-2 sm:gap-4">
  <span class="text-sm text-slate-700">Stuck in carline right now? Escape into a world where getting to your kid is just the click of a button.</span>
  <%= link_to "Play →", carline_play_path, class: "shrink-0 self-start sm:self-auto bg-indigo-600 hover:bg-indigo-700 text-white font-semibold rounded-lg px-4 py-2 text-sm" %>
</div>

<section class="flex items-baseline justify-between mb-4">
  <h2 class="text-lg font-semibold text-slate-900">What the raw data shows</h2>
  <%= link_to "Export the report ↓", carline_export_path(q: @q), class: "text-sm font-medium text-indigo-600 hover:text-indigo-800" %>
</section>

<section class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-4">
  <div class="bg-white border border-slate-200 rounded-lg p-5">
    <p class="text-3xl font-bold text-indigo-600"><%= @avg_wait %></p>
    <p class="text-sm text-slate-500 mt-1">avg. wait, minutes</p>
  </div>
  <div class="bg-white border border-slate-200 rounded-lg p-5">
    <p class="text-3xl font-bold text-indigo-600"><%= @worst_day&.worst_wait_minutes %></p>
    <p class="text-sm text-slate-500 mt-1">worst single wait</p>
  </div>
  <div class="bg-white border border-slate-200 rounded-lg p-5">
    <p class="text-3xl font-bold text-indigo-600"><%= @complaint_count %></p>
    <p class="text-sm text-slate-500 mt-1">complaints logged</p>
  </div>
  <div class="bg-white border border-slate-200 rounded-lg p-5">
    <p class="text-3xl font-bold text-indigo-600"><%= @days.count %></p>
    <p class="text-sm text-slate-500 mt-1">dismissals observed</p>
  </div>
</section>

<section class="mb-12">
  <h2 class="text-lg font-semibold text-slate-900 mb-4">Complaints by category</h2>
  <div class="flex flex-wrap gap-3">
    <% @complaints_by_category.sort_by { |_, n| -n }.each do |category, count| %>
      <div class="bg-white border border-slate-200 rounded-full px-4 py-1.5 text-sm text-slate-700">
        <span class="font-semibold text-indigo-600"><%= count %></span> <%= category %>
      </div>
    <% end %>
  </div>
</section>

<section class="mb-4">
  <h2 class="text-lg font-semibold text-slate-900 mb-1">Time series, not a point average</h2>
  <p class="text-sm text-slate-600 mb-4 max-w-2xl">
    n=30. Wait time decays over the adoption period, then stabilizes — the series reaches
    stationarity. <strong>Baseline is the stabilized value</strong>, not the decay period.
  </p>
  <div class="bg-white border border-slate-200 rounded-lg p-4 overflow-x-auto">
    <% max_wait = @days.map(&:avg_wait_minutes).max.to_f %>
    <% bar_w = 18; gap = 4; chart_h = 140 %>
    <svg width="<%= @days.size * (bar_w + gap) %>" height="168" class="min-w-full">
      <% plateau_y = chart_h - (@plateau_baseline / max_wait * chart_h) %>
      <line x1="0" y1="<%= plateau_y %>" x2="<%= @days.size * (bar_w + gap) %>" y2="<%= plateau_y %>" stroke="#a78bfa" stroke-dasharray="4,3" stroke-width="1.5" />
      <text x="4" y="<%= plateau_y - 4 %>" font-size="10" fill="#7c3aed">baseline ~<%= @plateau_baseline.round %> min</text>
      <% @days.each_with_index do |day, i| %>
        <% bar_h = (day.avg_wait_minutes / max_wait * chart_h).round %>
        <% is_plateau = @plateau_start && day.observed_on >= @plateau_start.observed_on %>
        <rect x="<%= i * (bar_w + gap) %>" y="<%= chart_h - bar_h %>" width="<%= bar_w %>" height="<%= bar_h %>" rx="2" fill="<%= is_plateau ? '#c4b5fd' : '#6366f1' %>">
          <title><%= day.observed_on.strftime("%b %-d") %>: <%= day.avg_wait_minutes %> min avg, <%= day.worst_wait_minutes %> min worst</title>
        </rect>
      <% end %>
      <text x="0" y="160" font-size="10" fill="#94a3b8">day 1</text>
      <text x="<%= (@days.size - 1) * (bar_w + gap) %>" y="160" font-size="10" fill="#94a3b8" text-anchor="end">day <%= @days.size %></text>
    </svg>
  </div>
  <p class="text-xs text-slate-400 mt-2">
    Indigo = pre-stationarity (adoption period). Purple = post-stationarity (baseline). Hover a bar
    for values.
  </p>
</section>

<p class="text-sm text-slate-600 max-w-2xl mb-12">
  At face value: wait time is high, optimize the carline. Loop redesign, staggered dismissal, added
  lane capacity — symptom-level interventions.
</p>

<section class="mb-16 bg-indigo-50 border border-indigo-200 rounded-lg p-6">
  <p class="text-sm font-semibold text-indigo-600 uppercase tracking-wide mb-2">Then we combined it with another dataset</p>
  <h2 class="text-lg font-semibold text-slate-900 mb-3">Family transport preferences — not just complaints</h2>
  <p class="text-sm text-slate-700 mb-4 max-w-2xl">
    Complaint volume is a measure of dissatisfaction, not cause. Second dataset: family-level
    attributes — extended-day enrollment, stated bus interest.
  </p>
  <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-4">
    <div>
      <p class="text-3xl font-bold text-slate-900"><%= @vocal_families.size %></p>
      <p class="text-sm text-slate-500">repeat-complaint families</p>
    </div>
    <div>
      <p class="text-3xl font-bold text-indigo-600"><%= @vocal_bus_ready_percent %>%</p>
      <p class="text-sm text-slate-500">of them are also extended-day families who already want a bus</p>
    </div>
    <div>
      <p class="text-3xl font-bold text-slate-900"><%= @bus_ready_families.count %></p>
      <p class="text-sm text-slate-500">families total who'd take a bus today, out of <%= @total_families %></p>
    </div>
  </div>
  <p class="text-sm text-slate-700 max-w-2xl">
    Complaint frequency correlates with bus-readiness, not randomly distributed across the
    population. Reframe: this is at least partly an <strong>unmet transport-demand</strong> problem,
    not a pure carline-throughput problem.
  </p>
  <p class="text-xs text-slate-400 mt-4 max-w-2xl">
    Honest footnote: a real 95% confidence interval at a ±5% margin needs roughly 384 families
    surveyed. This toy has 65. Real rigor means knowing your sample size before you trust your
    percentages — this page is a sketch of the method, not a finished study.
  </p>
</section>

<section class="mb-16">
  <h2 class="text-lg font-semibold text-slate-900 mb-2">So — not one fix, three</h2>
  <p class="text-sm text-slate-600 mb-6 max-w-2xl">
    Independent variables, not mutually exclusive. Toggle any combination — the projection updates.
  </p>

  <div data-controller="solution-mix"
       data-solution-mix-baseline-wait-value="<%= @plateau_baseline %>"
       data-solution-mix-bus-ready-value="<%= @bus_ready_families.count %>"
       data-solution-mix-effect-c-value="<%= @effect_c %>">

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      <label class="block bg-white border border-slate-200 rounded-lg p-5 cursor-pointer has-[:checked]:border-indigo-400 has-[:checked]:bg-indigo-50/40">
        <div class="flex items-start gap-2 mb-1">
          <input type="checkbox" checked data-solution-mix-target="optionA" data-action="solution-mix#recalculate" class="mt-1">
          <p class="text-xs uppercase tracking-wide text-slate-400 font-semibold">Option A</p>
        </div>
        <h3 class="font-semibold text-slate-900 mb-2">Earlier, organized check-in</h3>
        <p class="text-sm text-slate-600 mb-3">
          App-based (or a simple tag scan) check-in when a car enters the queue, so kids are staged in
          rounds and ready to hop in — instead of being paged after the car's already at the front.
        </p>
        <dl class="text-xs text-slate-500 space-y-1">
          <div><dt class="inline font-medium text-slate-600">Effort:</dt> <dd class="inline">Low-medium</dd></div>
          <div><dt class="inline font-medium text-slate-600">Timeline:</dt> <dd class="inline">Weeks</dd></div>
          <div><dt class="inline font-medium text-slate-600">Est. wait reduction:</dt> <dd class="inline">~15%</dd></div>
        </dl>
      </label>

      <label class="block bg-white border border-slate-200 rounded-lg p-5 cursor-pointer has-[:checked]:border-indigo-400 has-[:checked]:bg-indigo-50/40">
        <div class="flex items-start gap-2 mb-1">
          <input type="checkbox" data-solution-mix-target="optionB" data-action="solution-mix#recalculate" class="mt-1">
          <p class="text-xs uppercase tracking-wide text-slate-400 font-semibold">Option B</p>
        </div>
        <h3 class="font-semibold text-slate-900 mb-2">Stagger dismissal by grade</h3>
        <p class="text-sm text-slate-600 mb-3">Spread the surge instead of releasing every classroom at once.</p>
        <dl class="text-xs text-slate-500 space-y-1">
          <div><dt class="inline font-medium text-slate-600">Effort:</dt> <dd class="inline">Medium</dd></div>
          <div><dt class="inline font-medium text-slate-600">Timeline:</dt> <dd class="inline">Weeks</dd></div>
          <div><dt class="inline font-medium text-slate-600">Est. wait reduction:</dt> <dd class="inline">~20%</dd></div>
        </dl>
      </label>

      <label class="block bg-indigo-50 border border-indigo-300 rounded-lg p-5 cursor-pointer has-[:checked]:border-indigo-500">
        <div class="flex items-start gap-2 mb-1">
          <input type="checkbox" data-solution-mix-target="optionC" data-action="solution-mix#recalculate" class="mt-1">
          <p class="text-xs uppercase tracking-wide text-indigo-500 font-semibold">Option C</p>
        </div>
        <h3 class="font-semibold text-slate-900 mb-2">Afternoon bus route</h3>
        <p class="text-sm text-slate-600 mb-3">
          Route extended-day families who already want it. New driver jobs, a new revenue line for
          the school, fewer trips for those families — target the most vocal families first.
        </p>
        <dl class="text-xs text-slate-500 space-y-1">
          <div><dt class="inline font-medium text-slate-600">Effort:</dt> <dd class="inline">High</dd></div>
          <div><dt class="inline font-medium text-slate-600">Timeline:</dt> <dd class="inline">A semester</dd></div>
          <div><dt class="inline font-medium text-slate-600">Measured effect:</dt> <dd class="inline"><%= @bus_ready_families.count %> cars removable</dd></div>
        </dl>
      </label>
    </div>

    <div class="mt-4 bg-slate-900 text-slate-100 rounded-lg p-5">
      <p class="text-xs uppercase tracking-wide text-slate-400 font-semibold mb-3">Projected outcome for this combination</p>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-3">
        <div>
          <p class="text-2xl font-bold text-white" data-solution-mix-target="wait"></p>
          <p class="text-xs text-slate-400">projected wait</p>
        </div>
        <div>
          <p class="text-2xl font-bold text-white" data-solution-mix-target="cars"></p>
          <p class="text-xs text-slate-400">cars removed</p>
        </div>
        <div>
          <p class="text-2xl font-bold text-white" data-solution-mix-target="effort"></p>
          <p class="text-xs text-slate-400">effort</p>
        </div>
        <div>
          <p class="text-2xl font-bold text-white" data-solution-mix-target="timeline"></p>
          <p class="text-xs text-slate-400">timeline</p>
        </div>
      </div>
      <p class="text-xs text-slate-400" data-solution-mix-target="reduction"></p>
      <p class="text-xs text-slate-500 mt-2" data-solution-mix-target="note"></p>
    </div>
  </div>
</section>

<section class="mb-16">
  <h2 class="text-lg font-semibold text-slate-900 mb-2">A small example of build considerations</h2>
  <p class="text-sm text-slate-600 mb-1 max-w-2xl">
    Three source tables, joined on a real key, rolled into a derived signal not visible in any single
    table.
  </p>
  <p class="text-xs text-slate-400 mb-6 max-w-2xl">
    Simplified example of joins and derivations, pared down in complexity for the sake of a demo —
    production-scale data carries more sources, messier keys, and higher cardinality than this.
  </p>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-2" style="font-family: 'IBM Plex Mono', monospace;">
    <div class="bg-slate-900 text-slate-100 rounded-lg p-4 text-xs">
      <p class="text-purple-300 font-semibold mb-2">carline_days</p>
      <p>observed_on <span class="text-slate-500">date</span></p>
      <p>dismissal_time <span class="text-slate-500">string</span></p>
      <p>avg_wait_minutes <span class="text-slate-500">integer</span></p>
      <p>worst_wait_minutes <span class="text-slate-500">integer</span></p>
      <p>cars_in_line <span class="text-slate-500">integer</span></p>
      <p>note <span class="text-slate-500">text</span></p>
    </div>
    <div class="bg-slate-900 text-slate-100 rounded-lg p-4 text-xs">
      <p class="text-purple-300 font-semibold mb-2">complaints</p>
      <p>logged_on <span class="text-slate-500">date</span></p>
      <p>channel <span class="text-slate-500">string</span></p>
      <p>category <span class="text-slate-500">string</span></p>
      <p>severity <span class="text-slate-500">integer</span></p>
      <p>family_id <span class="text-indigo-400">fk → families.id</span></p>
    </div>
    <div class="bg-slate-900 text-slate-100 rounded-lg p-4 text-xs">
      <p class="text-purple-300 font-semibold mb-2">families</p>
      <p>label <span class="text-slate-500">string</span></p>
      <p>extended_day <span class="text-slate-500">boolean</span></p>
      <p>wants_bus <span class="text-slate-500">boolean</span></p>
      <p>carpool_interested <span class="text-slate-500">boolean</span></p>
    </div>
  </div>

  <p class="text-center text-slate-400 text-xs my-3">↓ JOIN complaints.family_id → families.id · aggregate carline_days as a time series ↓</p>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-2" style="font-family: 'IBM Plex Mono', monospace;">
    <div class="bg-slate-900 text-slate-100 rounded-lg p-4 text-xs">
      <p class="text-purple-300 font-semibold mb-2">family_signal <span class="text-slate-500 font-sans">(derived)</span></p>
      <p>family_id</p>
      <p>complaint_count <span class="text-slate-500">agg</span></p>
      <p>is_vocal <span class="text-slate-500">complaint_count >= 2</span></p>
      <p>extended_day, wants_bus <span class="text-slate-500">joined</span></p>
    </div>
    <div class="bg-slate-900 text-slate-100 rounded-lg p-4 text-xs">
      <p class="text-purple-300 font-semibold mb-2">wait_trend <span class="text-slate-500 font-sans">(derived)</span></p>
      <p>rolling_10day_avg</p>
      <p>plateau_start_date <span class="text-slate-500">first day within 15% of baseline</span></p>
      <p>plateau_baseline_minutes</p>
    </div>
  </div>

  <p class="text-center text-slate-400 text-xs my-3">↓ correlate ↓</p>

  <div class="bg-indigo-600 text-white rounded-lg p-5 text-sm">
    <strong><%= @vocal_bus_ready_percent %>% of vocal families are already bus-ready</strong> — a
    pattern invisible in any single source table, only visible after the join.
  </div>

  <div class="mt-4 border border-dashed border-slate-300 rounded-lg p-4 text-xs text-slate-500">
    <strong class="text-slate-600">Next layer, not built:</strong> embed complaint free-text and
    cluster semantically instead of by hand-typed category — surfaces groupings like "wants a real
    alternative" vs. "just venting" that a fixed category list can't see. Same honesty rule as the
    search box below: this is a sketch of where the method goes next, not a claim that it's running.
  </div>

  <details class="mt-6 group">
    <summary class="cursor-pointer text-xs font-semibold text-slate-400 hover:text-indigo-600 select-none">
      Peek at 5 raw rows from carline_days ▸
    </summary>
    <div class="overflow-x-auto mt-3">
      <table class="min-w-full text-xs border border-slate-200 rounded-lg overflow-hidden">
        <thead class="bg-slate-100 text-slate-600 text-left">
          <tr>
            <th class="px-3 py-1.5">Date</th>
            <th class="px-3 py-1.5">Avg wait</th>
            <th class="px-3 py-1.5">Worst wait</th>
            <th class="px-3 py-1.5">Cars</th>
            <th class="px-3 py-1.5">Field notes</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 bg-white">
          <% @days.first(5).each do |day| %>
            <tr>
              <td class="px-3 py-1.5 whitespace-nowrap"><%= day.observed_on.strftime("%b %-d") %></td>
              <td class="px-3 py-1.5"><%= day.avg_wait_minutes %> min</td>
              <td class="px-3 py-1.5 font-medium text-indigo-600"><%= day.worst_wait_minutes %> min</td>
              <td class="px-3 py-1.5"><%= day.cars_in_line %></td>
              <td class="px-3 py-1.5 text-slate-500"><%= day.note %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
      <p class="text-xs text-slate-400 mt-2">Full 30-day log is in the export.</p>
    </div>
  </details>
</section>

<section class="mb-4">
  <h2 class="text-lg font-semibold text-slate-900 mb-2">Search the log</h2>
  <%= form_with url: carline_path, method: :get, local: true, data: { turbo: false }, class: "flex gap-2 max-w-md" do %>
    <%= text_field_tag :q, @q, placeholder: "Try \"slow\" or \"guard\"", class: "flex-1 border border-slate-300 rounded-lg px-3 py-2 text-sm" %>
    <%= submit_tag "Search", class: "bg-slate-800 hover:bg-slate-900 text-white text-sm font-medium rounded-lg px-4 py-2 cursor-pointer" %>
    <% if @q %>
      <%= link_to "✕", carline_path, class: "flex items-center px-3 text-slate-400 hover:text-slate-700 text-sm" %>
    <% end %>
  <% end %>
  <p class="text-xs text-slate-400 mt-1">
    Keyword + synonym search, not real semantic search — the natural next step once this points at a real vector-capable store instead of a hand-typed table.
  </p>
</section>

<% if @q %>
  <section class="mb-4 bg-white border border-indigo-200 rounded-lg p-5">
    <div class="flex items-center justify-between mb-3">
      <p class="text-sm font-semibold text-slate-900">Results for "<%= @q %>"</p>
      <%= link_to "✕ clear", carline_path, class: "text-xs text-slate-400 hover:text-slate-700" %>
    </div>
    <% if @search[:days].none? && @search[:complaints].none? %>
      <p class="text-sm text-slate-500">Nothing matched. Try "slow," "suv," "guard," "bike," or "loop."</p>
    <% else %>
      <ul class="space-y-2 text-sm text-slate-700">
        <% @search[:days].each do |d| %>
          <li>📅 <%= d.observed_on.strftime("%b %-d") %> — <%= d.note %></li>
        <% end %>
        <% @search[:complaints].each do |c| %>
          <li>💬 <%= c.logged_on.strftime("%b %-d") %> — <%= c.category %> (<%= c.channel %>, <%= c.family_label %>)</li>
        <% end %>
      </ul>
    <% end %>
  </section>
<% end %>
