<%# Screen-only control bar. Hidden from the printed page by .no-print. %>
<div class="no-print sticky top-0 z-10 bg-white border-b border-slate-200 shadow-sm">
  <div class="max-w-3xl mx-auto px-8 py-3 flex flex-wrap items-center justify-between gap-3">
    <div class="flex items-center gap-4 text-sm">
      <%= link_to "← Back", root_path, class: "text-indigo-600 hover:text-indigo-800" %>
    </div>
    <button type="button" onclick="window.print()"
            class="bg-indigo-600 hover:bg-indigo-700 text-white font-semibold rounded-lg px-4 py-2 text-sm">
      Print / Save as PDF
    </button>
  </div>
</div>

<article class="print-doc max-w-3xl mx-auto bg-white px-8 py-10 my-6 shadow-sm">
  <header class="mb-6">
    <h1 class="text-3xl font-bold tracking-tight"><%= @profile.name %></h1>
    <p class="text-slate-700 mt-1"><%= @profile.headline %></p>
    <p class="text-sm text-slate-600 mt-2">
      <%= [ @profile.location,
            @profile.linkedin_url&.sub(%r{\Ahttps?://(www\.)?}, ""),
            @profile.github_url&.sub(%r{\Ahttps?://(www\.)?}, ""),
            "resumeonrails.com" ].compact_blank.join(" · ") %>
    </p>
  </header>

  <% if @profile.print_summary_lines.any? %>
    <section class="mb-6">
      <h2 class="print-h2">Summary</h2>
      <ul class="text-sm space-y-1">
        <% @profile.print_summary_lines.each do |line| %>
          <li class="print-bullet"><%= line %></li>
        <% end %>
      </ul>
    </section>
  <% end %>

  <section class="mb-6">
    <h2 class="print-h2">Skills</h2>
    <%# Fixed label column so every skill list starts at the same left edge. %>
    <dl class="text-sm grid grid-cols-1 sm:grid-cols-[11rem_1fr] gap-x-3 gap-y-1">
      <% Skill.categories.each do |category| %>
        <dt class="font-semibold"><%= category %></dt>
        <dd class="print-entry"><%= category_pills(category).join(", ") %></dd>
      <% end %>
    </dl>
  </section>

  <%# Experience starts its own page: page one is who she is, the rest is what
      she's done, so a job never straddles that boundary. %>
  <section class="mb-6 print-break-before">
    <h2 class="print-h2">Experience</h2>
    <% @roles.each do |role| %>
      <% if role.print_condensed? %>
        <%# Earliest roles: one line each, smaller. Present, not dwelt on. %>
        <div class="print-entry print-minor text-sm mb-2">
          <div class="flex items-baseline justify-between gap-4">
            <span><span class="font-semibold"><%= role.title %></span>, <%= role.organization %></span>
            <span class="text-slate-600 shrink-0 whitespace-nowrap"><%= role.date_range %></span>
          </div>
          <% if role.print_bullet_list.first.present? %>
            <p class="text-slate-700"><%= role.print_bullet_list.first %></p>
          <% end %>
        </div>
      <% else %>
        <div class="print-role mb-4">
          <%# Kept together, and never left stranded at the foot of a page. %>
          <div class="print-role-head">
            <div class="flex items-baseline justify-between gap-4">
              <h3 class="font-semibold"><%= role.title %></h3>
              <span class="text-sm text-slate-600 shrink-0 whitespace-nowrap"><%= role.date_range %></span>
            </div>
            <p class="text-sm text-slate-700"><%= role.organization %><%= " · #{role.location}" if role.location.present? %></p>
          </div>
          <ul class="mt-1 text-sm space-y-1">
            <% role.print_bullet_list.each do |bullet| %>
              <li class="print-bullet"><%= bullet %></li>
            <% end %>
          </ul>
        </div>
      <% end %>
    <% end %>
  </section>

  <section class="mb-6">
    <h2 class="print-h2">Education</h2>
    <ul class="text-sm space-y-1 print-minor">
      <% @education.each do |e| %>
        <li class="print-entry">
          <span class="font-semibold"><%= e.headline %></span><%
            %><% if e.honor.present? %> - <%= e.honor %><% end %><%
            %><% if e.context_line.present? %> <span class="text-slate-600">· <%= e.context_line %></span><% end %>
        </li>
      <% end %>
    </ul>
  </section>

</article>
