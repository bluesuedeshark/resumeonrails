<% content_for :title, "Timeline — #{Profile.current.name}" %>

<h1 class="text-2xl font-bold text-slate-900 mb-2">Timeline</h1>
<p class="text-slate-600 mb-10">Every role is a record; every bullet below is a real accomplishment tied to it. Click a skill to see everywhere it shows up.</p>

<div class="space-y-12">
  <% @roles.each do |role| %>
    <div class="grid grid-cols-1 md:grid-cols-[180px_1fr] gap-3 md:gap-8">
      <div class="text-sm text-slate-500 md:text-right">
        <%= role.date_range %>
        <% if role.kind == "origin" %>
          <div class="mt-1 inline-block md:block text-xs uppercase tracking-wide text-indigo-500 font-semibold">Origin story</div>
        <% end %>
      </div>
      <div class="border-l-2 border-slate-200 pl-5 pb-2">
        <h2 class="font-semibold text-slate-900 text-lg"><%= role.title %></h2>
        <p class="text-sm text-slate-500 mb-2"><%= role.organization %><%= " · #{role.location}" if role.location.present? %></p>
        <% if role.summary.present? %>
          <p class="text-sm text-slate-600 italic mb-3"><%= role.summary %></p>
        <% end %>
        <ul class="space-y-2">
          <% role.accomplishments.ordered.each do |a| %>
            <li class="text-sm text-slate-700">
              <%= a.description %>
              <% if a.metric.present? %><span class="text-indigo-600 font-medium">— <%= a.metric %></span><% end %>
              <% if a.skills.any? %>
                <span class="block mt-1 space-x-1">
                  <% a.skills.each do |skill| %>
                    <%= link_to skill.name, skill_path(skill), class: "inline-block text-xs bg-slate-100 hover:bg-indigo-100 hover:text-indigo-700 text-slate-600 rounded-full px-2 py-0.5" %>
                  <% end %>
                </span>
              <% end %>
            </li>
          <% end %>
        </ul>
      </div>
    </div>
  <% end %>
</div>

<h2 class="text-lg font-semibold text-slate-900 mt-16 mb-4">Education</h2>
<ul class="space-y-2 text-sm text-slate-700">
  <% Education.ordered.each do |e| %>
    <li>
      <span class="font-medium text-slate-900"><%= e.institution %></span>
      <% if e.credential.present? %> — <%= e.credential %><% end %>
      <% if e.honor.present? %><span class="text-indigo-600"> (<%= e.honor %>)</span><% end %>
      <% if e.location.present? %><span class="text-slate-500"> · <%= e.location %></span><% end %>
    </li>
  <% end %>
</ul>

<h2 class="text-lg font-semibold text-slate-900 mt-16 mb-4">All skills</h2>
<% @skills.group_by(&:category).each do |category, skills| %>
  <div class="mb-4">
    <p class="text-xs uppercase tracking-wide text-slate-500 font-semibold mb-2"><%= category %></p>
    <div class="flex flex-wrap gap-2">
      <% skills.each do |skill| %>
        <%= link_to skill.name, skill_path(skill), class: "inline-block text-sm bg-white border border-slate-200 hover:border-indigo-400 hover:text-indigo-700 text-slate-700 rounded-full px-3 py-1" %>
      <% end %>
    </div>
  </div>
<% end %>
