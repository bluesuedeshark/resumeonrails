<% content_for :title, "#{@profile.name} - #{@profile.headline}" %>

<section class="mb-8">
  <p class="text-sm font-semibold text-indigo-600 tracking-wide uppercase mb-2 flex items-center gap-2">
    <span style="font-family: 'IBM Plex Mono', monospace;">Resume on</span>
    <%= image_tag "rails-logo.svg", alt: "Rails", class: "h-4" %>
  </p>
  <h1 class="text-4xl font-bold tracking-tight text-slate-900 mb-3"><%= @profile.name %></h1>
  <p class="text-xl text-slate-600 mb-6"><%= @profile.headline %></p>
  <p class="text-lg text-slate-700 leading-relaxed max-w-2xl whitespace-pre-line"><%= @profile.tagline %></p>
</section>

<section class="mb-16 max-w-2xl">
  <% @profile.intro.split("\n\n").each do |paragraph| %>
    <p class="text-slate-700 leading-relaxed mb-4 last:mb-0"><%= paragraph %></p>
  <% end %>
</section>

<section class="mb-16">
  <h2 class="text-lg font-semibold text-slate-900 mb-4">Relevant skills</h2>
  <div class="flex flex-wrap gap-2">
    <% @skill_categories.each do |category| %>
      <%= link_to category, category_path(Skill.category_slug(category)), class: pill_class(:category) %>
    <% end %>
  </div>
</section>

<section id="highlights" class="scroll-mt-10">
  <div class="flex items-baseline justify-between mb-6">
    <h2 class="text-lg font-semibold text-slate-900">Some things I do...</h2>
    <%= link_to "Full timeline →", timeline_path, class: "text-sm font-medium text-indigo-600 hover:text-indigo-800" %>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <% @featured_projects.each do |a| %>
      <%= link_to timeline_path(anchor: "role-#{a.role.id}"), class: "group block bg-white border border-slate-200 hover:border-indigo-400 rounded-lg p-4" do %>
        <p class="text-sm text-slate-700"><%= a.description %></p>
        <p class="text-indigo-600 font-semibold text-sm mt-1"><%= a.metric %></p>
        <p class="text-xs text-slate-400 mt-2 max-h-0 overflow-hidden group-hover:max-h-12 transition-all duration-200">
          <%= a.role.title %> · <%= a.role.organization %> · <%= a.role.date_range %>
        </p>
      <% end %>
    <% end %>
  </div>

  <div class="mt-6 text-center">
    <%= link_to "Full timeline →", timeline_path, class: "inline-block text-sm font-medium text-indigo-600 hover:text-indigo-800" %>
  </div>
</section>
